#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CARGO_NET_GIT_FETCH_WITH_CLI=true
case "${1:-}" in
  --fast | '') ;;
  *)
    echo "usage: bin/gate [--fast]" >&2
    exit 2
    ;;
esac
if [ -d .dev ]; then .dev/bin/story-check; fi
cargo fmt --check
cargo clippy --all-targets -- -D warnings
if cargo nextest --version >/dev/null 2>&1; then cargo nextest run --no-tests=pass; else cargo test --quiet; fi
if [ "${1:-}" = --fast ]; then
  echo "fast gate: green (the full gate is plain bin/gate)"
  exit 0
fi
cargo build --release
bin/budget
(cd render/web && npm ci --no-fund --no-audit)
(cd worker && npm ci --no-fund --no-audit && npm test)
node --test render/web/coverage.test.mjs
echo "gate: green"
